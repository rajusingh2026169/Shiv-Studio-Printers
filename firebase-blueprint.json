  "firestore": {
    "users/{userId}": { "schema": "UserProfile", "description": "Private user account profiles" },
    "admins/{adminId}": { "schema": "AdminMarker", "description": "Trusted admin role marker documents" },
    "services/{serviceId}": { "schema": "ServiceItem", "description": "Studio and printing service catalog" },
