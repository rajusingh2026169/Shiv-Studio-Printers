{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered studio user profile with role and contact metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "name": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 40 },
        "mobile": { "type": "string", "maxLength": 40 },
        "role": {
          "type": "string",
          "enum": ["admin", "customer", "Super Admin", "Admin", "Photographer", "Designer", "Printing Staff", "Customer"]
        },
        "address": { "type": "string", "maxLength": 500 },
        "avatarUrl": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "fullName", "role", "createdAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted administrator lookup marker document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "grantedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid"]
    },
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Photography, videography, album, gift, and printing service offering",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 160 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 8000 },
        "shortDescription": { "type": "string", "maxLength": 600 },
