      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 250 },
        "title": { "type": "string", "maxLength": 250 },
        "slug": { "type": "string", "maxLength": 250 },
        "sku": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 10000 },
        "shortDescription": { "type": "string", "maxLength": 1000 },
        "thumbnailUrl": { "type": "string", "maxLength": 2048 },
        "coverImageUrl": { "type": "string", "maxLength": 2048 },
        "image": { "type": "string", "maxLength": 2048 },
        "price": { "type": "number" },
        "discount": { "type": "number" },
        "discountPrice": { "type": "number" },
        "stock": { "type": "number" },
        "GST": { "type": "number" },
        "gstPercent": { "type": "number" },
        "tags": { "type": "array" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "brand": { "type": "string", "maxLength": 120 },
        "unit": { "type": "string", "maxLength": 40 },
